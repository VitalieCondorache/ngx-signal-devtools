{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "git": {
    "commit": true,
    "commitMessage": "chore(release): v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "Release v${version}",
    "requireBranch": "main",
    "requireCleanWorkingDir": false,
    "push": false
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "comments": {
      "submit": true,
      "issue": ":rocket: Released in v${version}"
    }
  },
  "npm": {
    "publish": true,
    "publishPath": "dist/vitalie/ngx-signal-devtools",
    "publishArgs": ["--provenance", "--access", "public"]
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "conventionalcommits",
        "types": [
          { "type": "feat", "section": "Features" },
          { "type": "fix", "section": "Bug fixes" },
          { "type": "perf", "section": "Performance" },
          { "type": "docs", "section": "Documentation" },
          { "type": "refactor", "section": "Refactoring" },
          { "type": "test", "section": "Tests" },
          { "type": "build", "section": "Build" },
          { "type": "ci", "section": "CI" }
        ]
      },
      "infile": "projects/ngx-signal-devtools/CHANGELOG.md",
      "header": "# Changelog\n\nAll notable changes to this project are documented here. The format follows [Keep a Changelog](https://keepachangelog.com/en/1.1.0/) and the project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0.html).\n"
    }
  },
  "hooks": {
    "before:init": ["npm run lint", "npm run test:all"]
  }
}
