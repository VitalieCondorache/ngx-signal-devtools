{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":dependencyDashboard"],
  "schedule": ["before 6am on monday"],
  "labels": ["deps"],
  "packageRules": [
    {
      "description": "Angular packages must move together",
      "groupName": "angular",
      "matchPackageNames": ["/@angular/", "angular-eslint", "ng-packagr", "@angular-eslint/{/,}**"]
    },
    {
      "description": "Keep the library peer range in sync with the tested Angular majors",
      "matchFileNames": ["projects/ngx-signal-devtools/package.json"],
      "rangeStrategy": "replace"
    },
    {
      "description": "TypeScript is pinned by the Angular compiler",
      "matchPackageNames": ["typescript"],
      "rangeStrategy": "replace"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  }
}
