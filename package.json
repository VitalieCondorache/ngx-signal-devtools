{
  "name": "ngx-signal-devtools",
  "version": "0.1.0",
  "description": "Workspace for @vitalie/ngx-signal-devtools — a dev-only overlay for Angular signals.",
  "private": true,
  "license": "MIT",
  "author": "Vitalie",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "ng build @vitalie/ngx-signal-devtools",
    "watch:lib": "ng build @vitalie/ngx-signal-devtools --watch --configuration development",
    "build:demo": "ng build demo",
    "test": "npm run test:lib",
    "test:lib": "ng test @vitalie/ngx-signal-devtools --coverage",
    "test:demo": "ng test demo",
    "test:all": "npm run test:lib && npm run test:demo",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "probe:internals": "node tools/probe-internals.mjs",
    "pack:lib": "npm run build:lib && cd dist/vitalie/ngx-signal-devtools && npm pack --dry-run",
    "release": "npm run build:lib && release-it",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.1",
    "@angular/cli": "^22.1.1",
    "@angular/compiler-cli": "^22.1.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@vitest/coverage-v8": "^4.0.8",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.6.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "release-it": "^21.1.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "*.{ts,mjs,html,css,json,md}": "prettier --write"
  }
}
